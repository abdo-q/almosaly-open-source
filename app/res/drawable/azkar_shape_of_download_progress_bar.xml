<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="98.0dip" android:topRightRadius="98.0dip" android:bottomLeftRadius="98.0dip" android:bottomRightRadius="98.0dip" />
            <stroke android:width="1.0dip" android:color="@color/white" />
            <solid android:color="#ffeae5e5" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:topLeftRadius="98.0dip" android:topRightRadius="98.0dip" android:bottomLeftRadius="98.0dip" android:bottomRightRadius="98.0dip" />
                <solid android:color="#ff7bbb19" />
            </shape>
        </scale>
    </item>
</layer-list>