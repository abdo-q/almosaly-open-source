<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="98.0dip" android:topRightRadius="98.0dip" android:bottomLeftRadius="98.0dip" android:bottomRightRadius="98.0dip" />
            <stroke android:width="1.0dip" android:color="#ffececec" />
            <gradient android:startColor="#ffececec" android:endColor="#ffececec" android:angle="0.0" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:topLeftRadius="98.0dip" android:topRightRadius="98.0dip" android:bottomLeftRadius="98.0dip" android:bottomRightRadius="98.0dip" />
                <gradient android:startColor="#ffbcdd88" android:endColor="#ff6faf0a" android:angle="0.0" android:type="linear" android:centerColor="#ffb9ce4d" />
            </shape>
        </clip>
    </item>
</layer-list>