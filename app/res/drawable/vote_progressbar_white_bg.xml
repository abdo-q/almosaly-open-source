<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill_horizontal|center" android:id="@android:id/secondaryProgress">
        <scale android:scaleWidth="100%">
            <shape android:tint="@color/white" android:shape="rectangle">
                <corners android:radius="15.0dip" />
                <solid android:color="@color/white" />
            </shape>
        </scale>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:tint="@color/blue_trans" android:shape="rectangle">
                <corners android:radius="15.0dip" />
                <solid android:color="@color/blue_trans" />
            </shape>
        </scale>
    </item>
</layer-list>