<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="98.0dip" android:topRightRadius="98.0dip" android:bottomLeftRadius="98.0dip" android:bottomRightRadius="98.0dip" />
            <stroke android:width="1.0dip" android:color="@color/platinum" />
            <gradient android:startColor="@color/platinum" android:endColor="@color/platinum" android:angle="0.0" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:topLeftRadius="98.0dip" android:topRightRadius="98.0dip" android:bottomLeftRadius="98.0dip" android:bottomRightRadius="98.0dip" />
                <gradient android:startColor="#ffbadb86" android:endColor="#ff6fa126" android:angle="0.0" android:type="linear" android:centerColor="#ff95bf54" />
            </shape>
        </clip>
    </item>
</layer-list>