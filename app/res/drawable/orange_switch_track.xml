<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <solid android:color="#ffd8d7d7" />
            <corners android:radius="100.0sp" /> android:width="2dp"/> </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/default_header_color" />
            <corners android:radius="100.0sp" />
        </shape>
    </item>
</selector>